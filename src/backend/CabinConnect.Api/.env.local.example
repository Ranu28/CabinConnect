# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit your real connection string.
#
# .NET configuration uses double-underscore (__) as the section separator,
# so ConnectionStrings__Supabase maps to ConnectionStrings:Supabase in appsettings.
#
# Find your connection details in:
#   Supabase → Project Settings → Database → Connection string → URI

ConnectionStrings__Supabase=Host=db.YOUR_PROJECT_REF.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;

